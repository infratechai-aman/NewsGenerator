rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. CONTACTS: Public can create, only admin can read
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false; // Assuming only Admin SDK (server-side) reads these
    }

    // 2. USERS: Only the user can read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. REPOSITORY/NEWSPAPERS: Authenticated user isolation
    match /newspapers/{document} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // 4. SETTINGS: Read-only for authenticated users, write for admin
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }

    // Global default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
